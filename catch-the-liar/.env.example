# Copy to .env for local overrides (never commit real secrets).

# PostgreSQL connection string (Supabase / Neon / Render Postgres…).
# When empty the server uses an embedded database (PGlite): fine for testing,
# but data is lost when the server restarts on hosts without a persistent disk.
DATABASE_URL=

# disable | no-verify | verify   (default: no-verify for remote hosts)
DATABASE_SSL=

# Embedded database folder when DATABASE_URL is empty ('memory://' = RAM only).
PGLITE_DIR=.data/pglite

PORT=3000

# Public address of the site, used in link previews (auto-detected when empty).
PUBLIC_URL=

# Extra allowed browser origins for the realtime connection (comma separated).
ALLOWED_ORIGINS=

# Monetization switches (keep off until a real ad provider is connected).
ADS_ENABLED=false
